@using Nop.Web.Areas.Admin.Models.Blogs.Categories
@model Nop.Web.Areas.Admin.Models.Blogs.Categories.BlogCategoryModel

@if (Model.Id > 0)
{
    <div class="card-body">
        @await Html.PartialAsync("Table", new DataTablesModel
        {
            Name = "blog-posts-grid",
            UrlRead = new DataUrl("BlogsList", "BlogCategory", new RouteValueDictionary { [nameof(Model.BlogCategoryBlogPostSearchModel.CategoryId)] = Model.BlogCategoryBlogPostSearchModel.CategoryId }),
            UrlDelete = new DataUrl("BlogDelete", "BlogCategory", null),
            UrlUpdate = new DataUrl("BlogUpdate", "BlogCategory", null),
            Length = Model.BlogCategoryBlogPostSearchModel.PageSize,
            LengthMenu = Model.BlogCategoryBlogPostSearchModel.AvailablePageSizes,
            ColumnCollection = new List<ColumnProperty>
                {
                    new ColumnProperty(nameof(BlogCategoryBlogPostModel.BlogPostName))
                    {
                        Title = T("Admin.ContentManagement.BlogCategories.BlogPost.Fields.Blog").Text
                    },
                    new ColumnProperty(nameof(BlogCategoryBlogPostModel.IsFeaturedBlog))
                    {
                        Title = T("Admin.ContentManagement.BlogCategories.BlogPost.Fields.IsFeaturedBlog").Text,
                        Width = "150",
                        ClassName = NopColumnClassDefaults.CenterAll,
                        Render = new RenderBoolean(),
                        Editable = true,
                        EditType = EditType.Checkbox
                    },
                    new ColumnProperty(nameof(BlogCategoryBlogPostModel.DisplayOrder))
                    {
                        Title = T("Admin.ContentManagement.BlogCategories.BlogPost.Fields.DisplayOrder").Text,
                        Width = "150",
                        ClassName = NopColumnClassDefaults.CenterAll,
                        Editable = true,
                        EditType = EditType.Number
                    },
                    new ColumnProperty(nameof(BlogCategoryBlogPostModel.BlogPostId))
                    {
                        Title = T("Admin.Common.View").Text,
                        Width = "150",
                        ClassName = NopColumnClassDefaults.Button,
                        Render = new RenderButtonView(new DataUrl("~/Admin/BlogPost/Edit/", nameof(BlogCategoryBlogPostModel.BlogPostId)))
                    },
                    new ColumnProperty(nameof(BlogCategoryBlogPostModel.Id))
                    {
                        Title = T("Admin.Common.Edit").Text,
                        Width = "200",
                        ClassName =  NopColumnClassDefaults.Button,
                        Render = new RenderButtonsInlineEdit()
                    },
                    new ColumnProperty(nameof(CategoryProductModel.Id))
                    {
                        Title = T("Admin.Common.Delete").Text,
                        Width = "100",
                        Render = new RenderButtonRemove(T("Admin.Common.Delete").Text),
                        ClassName = NopColumnClassDefaults.Button
                    }
                }
        })
    </div>
    <div class="card-footer">
        <button type="submit" id="btnAddNewProduct"
                onclick="javascript:OpenWindow('@(Url.Action("BlogAddPopup", "BlogCategory", new { categoryId = Model.Id, btnId = "btnRefreshProducts", formId = "blog-category-form" }))', 800, 800, true); return false;"
                class="btn btn-primary">
            @T("Admin.ContentManagement.Blog.Categories.BlogPosts.AddNew")
        </button>
        <button type="submit" id="btnRefreshBlogs" style="display: none"></button>
        <script>
            $(function() {
                $('#btnRefreshProducts').click(function () {
                    //refresh grid
                    updateTable('#blogs-grid');

                    //return false to don't reload a page
                    return false;
                });
            });
        </script>
    </div>
}
else
{
    <div class="card-body">
        @T("Admin.ContentManagement.Blog.Categories.BlogPosts.SaveBeforeEdit")
    </div>
}

